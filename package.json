{
  "name": "cloudwarden",
  "version": "0.1.0",
  "private": true,
  "description": "A personal Bitwarden-compatible vault server for Cloudflare Workers, D1, and R2.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "npm run typecheck && node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply cloudwarden-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cloudwarden-db --remote",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.18.0"
  }
}
